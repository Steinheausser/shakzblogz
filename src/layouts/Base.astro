---
import { SITE_TITLE, SITE_TAGLINE, url } from '../lib/site';

interface Props {
	title?: string;
	description?: string;
}

const { title, description = SITE_TAGLINE } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const path = Astro.url.pathname;
const nav = [
	{ href: url('/blog/'), label: 'blog' },
	{ href: url('/poetry/'), label: 'poetry' },
	{ href: url('/about/'), label: 'about' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;1,7..72,400&display=swap"
		/>
		<title>{pageTitle}</title>
		<script is:inline>
			// Dark by default; remember the reader's choice. Runs before paint to avoid a flash.
			try {
				document.documentElement.dataset.theme = localStorage.getItem('theme') || 'dark';
			} catch {
				document.documentElement.dataset.theme = 'dark';
			}
		</script>
	</head>
	<body>
		<header class="site-header">
			<a class="brand" href={url('/')}>{SITE_TITLE}</a>
			<nav>
				{
					nav.map((item) => (
						<a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
							{item.label}
						</a>
					))
				}
				<button class="theme-toggle" type="button" aria-label="Toggle light and dark mode">
					<span class="to-light">light</span><span class="to-dark">dark</span>
				</button>
			</nav>
		</header>
		<script is:inline>
			document.querySelector('.theme-toggle').addEventListener('click', () => {
				const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
				document.documentElement.dataset.theme = next;
				try {
					localStorage.setItem('theme', next);
				} catch {}
			});
		</script>
		<main>
			<slot />
		</main>
		<footer class="site-footer">
			<span>&copy; {new Date().getFullYear()} {SITE_TITLE}</span>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--paper: #e9d8b4;
		--paper-edge: #dcc69a;
		--ink: #35281a;
		--ink-soft: #66533b;
		--accent: #874118;
		--rule: #c9b083;
		--tint: #dcc69a;
		--select: #d4b77f;
		--measure: 38rem;
		color-scheme: light;
	}

	:root[data-theme='dark'] {
		--paper: #211b14;
		--paper-edge: #17130e;
		--ink: #e6d6b8;
		--ink-soft: #a8957a;
		--accent: #d99a5f;
		--rule: #44382a;
		--tint: #2e261c;
		--select: #5a4630;
		color-scheme: dark;
	}

	* {
		box-sizing: border-box;
	}

	html {
		background: radial-gradient(ellipse at center, var(--paper) 60%, var(--paper-edge) 100%) fixed
			var(--paper);
	}

	body {
		margin: 0 auto;
		max-width: var(--measure);
		padding: 3rem 1.25rem 2rem;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		color: var(--ink);
		font-family: 'Literata', Georgia, serif;
		font-size: 1.1rem;
		line-height: 1.75;
		-webkit-font-smoothing: antialiased;
	}

	main {
		flex: 1;
	}

	a {
		color: var(--accent);
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
	}

	a:hover {
		color: var(--ink);
	}

	h1,
	h2,
	h3 {
		font-weight: 600;
		line-height: 1.25;
		margin: 2rem 0 0.75rem;
	}

	h1 {
		font-size: 2rem;
		margin-top: 0;
	}

	hr {
		border: 0;
		border-top: 1px solid var(--rule);
		margin: 2.5rem 0;
	}

	blockquote {
		margin: 1.5rem 0;
		padding-left: 1.25rem;
		border-left: 2px solid var(--rule);
		color: var(--ink-soft);
		font-style: italic;
	}

	img {
		max-width: 100%;
		height: auto;
	}

	code {
		font-size: 0.85em;
		background: var(--tint);
		padding: 0.1em 0.3em;
		border-radius: 3px;
	}

	::selection {
		background: var(--select);
	}

	.muted {
		color: var(--ink-soft);
	}

	.site-header {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		margin-bottom: 3.5rem;
	}

	.brand {
		font-size: 1.4rem;
		font-style: italic;
		color: var(--ink);
		text-decoration: none;
	}

	.site-header nav {
		display: flex;
		gap: 1.25rem;
	}

	.site-header nav a {
		color: var(--ink-soft);
		text-decoration: none;
	}

	.site-header nav a:hover,
	.site-header nav a[aria-current='page'] {
		color: var(--ink);
		text-decoration: underline;
		text-decoration-color: var(--rule);
	}

	.theme-toggle {
		font: inherit;
		color: var(--ink-soft);
		background: none;
		border: 0;
		border-left: 1px solid var(--rule);
		padding: 0 0 0 1.25rem;
		cursor: pointer;
	}

	.theme-toggle:hover {
		color: var(--ink);
	}

	[data-theme='dark'] .to-dark,
	:root:not([data-theme='dark']) .to-light {
		display: none;
	}

	.site-footer {
		margin-top: 4rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--rule);
		font-size: 0.95rem;
		color: var(--ink-soft);
	}
</style>
